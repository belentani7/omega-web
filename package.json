{
  "name": "omega-web",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node serve-dist.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "lint": "eslint js tools tests galaxias/core/galaxia.js",
    "check:encoding": "node tools/fix-encoding.mjs --check",
    "check:html": "node tools/check-html.mjs --check",
    "check:links": "node tools/check-links.mjs --check",
    "check:css": "node tools/audit-css.mjs --check",
    "check": "npm run check:encoding && npm run check:html && npm run check:links && npm run check:css",
    "verify": "npm run check && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "vite": "^5.2.11",
    "vite-plugin-glsl": "^1.3.0"
  },
  "dependencies": {
    "cannon": "^0.6.2",
    "dat.gui": "^0.7.9",
    "gsap": "^3.12.5",
    "howler": "^2.2.4",
    "three": "^0.164.1",
    "vite-plugin-restart": "^2.0.0"
  },
  "description": "Universo interactivo BELENTANI: ocho mundos WebGL procedurais, cincuenta capítulos originales e infraestructura de verificación propia.",
  "private": true
}
